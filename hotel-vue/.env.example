# Скопіюйте цей файл у .env, якщо треба змінити адресу API.
# Open-Meteo не потребує ключа. Не записуйте сюди секретні ключі:
# усі змінні VITE_* потрапляють у збірку і їх видно в браузері.
#
# Порожнє значення означає адресу за замовчуванням із src/config/api.js.
VITE_API_URL=

# Перевірка порожнього стану (API поверне 0 днів):
# VITE_API_URL=https://api.open-meteo.com/v1/forecast?latitude=50.4433&longitude=30.5077&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,uv_index_max,sunrise,sunset&timezone=Europe%2FKyiv&forecast_days=0

# Перевірка HTTP-помилки (404):
# VITE_API_URL=https://api.open-meteo.com/v1/forecast-wrong
